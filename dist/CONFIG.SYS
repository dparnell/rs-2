REM rs2 system configuration
LIBPATH=.;C:\OS2\DLL;C:\OS2;C:\OS2\APPS;C:\
SET PATH=C:\OS2;C:\OS2\SYSTEM;C:\OS2\APPS;C:\RS2;C:\
SET DPATH=C:\OS2;C:\OS2\SYSTEM;C:\RS2;C:\
SET PROMPT=$i[$p]
SET ETC=C:\MPTN\ETC
SET HELP=C:\OS2\HELP
SET BOOKSHELF=C:\OS2\BOOK
REM Multimedia (MMPM/2): sounds and other media files in %MMBASE%
SET MMBASE=C:\MMOS2;
SET COMSPEC=C:\OS2\CMD.EXE
SET OS2_SHELL=C:\OS2\CMD.EXE
REM PM: milliseconds before a program that does not take its input is "not responding"
SET PM_HANGTIME=2000
REM The shell: the desktop (Presentation Manager with the Workplace Shell).
REM For the text-mode command prompt instead, put REM before the first
REM PROTSHELL line and remove it from the second. Pressing T while the boot
REM loader waits, or "textmode" in \RS2\CMDLINE, also boots to the command
REM prompt.
PROTSHELL=C:\OS2\PMSHELL.EXE
REM PROTSHELL=C:\OS2\CMD.EXE
REM RS2SHELL, rs2's earlier desktop (no SOM), instead of the Workplace Shell:
REM PROTSHELL=C:\OS2\RS2SHELL.EXE

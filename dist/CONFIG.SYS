REM rs2 system configuration
LIBPATH=.;C:\OS2\DLL;C:\OS2;C:\
SET PATH=C:\OS2;C:\OS2\SYSTEM;C:\RS2;C:\
SET DPATH=C:\OS2;C:\OS2\SYSTEM;C:\RS2;C:\
SET PROMPT=$i[$p]
SET ETC=C:\MPTN\ETC
SET COMSPEC=C:\OS2\CMD.EXE
SET OS2_SHELL=C:\OS2\CMD.EXE
REM PM: milliseconds before a program that does not take its input is "not responding"
SET PM_HANGTIME=2000
PROTSHELL=C:\OS2\CMD.EXE

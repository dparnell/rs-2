/* Menus and accelerator tables. */
#include <os2.h>

#define IDM(n) (1000 + (n))

MENU 1
BEGIN
  MENUITEM "~Alpha", 100
  MENUITEM "~Beta\tCtrl+B", 101, MIS_TEXT, MIA_CHECKED
  MENUITEM "Gamma", 102, , MIA_DISABLED
  MENUITEM "Delta", 103, MIS_TEXT | MIS_BREAK
  MENUITEM SEPARATOR
  MENUITEM "Right\aside", 104, MIS_HELP
  MENUITEM "Sys", SC_CLOSE, MIS_SYSCOMMAND
  MENUITEM "#5", 105, MIS_BITMAP
  MENUITEM "", 106, MIS_OWNERDRAW
  MENUITEM "Stat", 107, MIS_STATIC
  MENUITEM "Sep2", 108, MIS_SEPARATOR
  MENUITEM "Framed", 109, MIS_TEXT, MIA_FRAMED | MIA_HILITED | MIA_NODISMISS
  SUBMENU "~Sub", 200
  BEGIN
    MENUITEM "One", IDM(1)
    SUBMENU "Deeper", 201, MIS_TEXT
    BEGIN
      MENUITEM "Two", IDM(2)
    END
    MENUITEM "Three", IDM(3), MIS_TEXT | MIS_BREAKSEPARATOR
  END
  SUBMENU "Sub2", 202, MIS_BUTTONSEPARATOR
  BEGIN
    MENUITEM "x", 300
  END
  MENUITEM "As submenu", 203, MIS_SUBMENU
  BEGIN
    MENUITEM "y", 301
  END
END

MENU 2 PRELOAD
BEGIN
  PRESPARAMS PP_FONTNAMESIZE, "8.Helv"
  MENUITEM "With font", 1
  SUBMENU "Sub", 2
  BEGIN
    PRESPARAMS PP_FOREGROUNDCOLORINDEX, CLR_RED
    MENUITEM "Red", 3
  END
END

MENU 3 FIXED
{
  MENUITEM "Braces", 1
}

MENU 4
BEGIN
  PRESPARAMS PP_BACKGROUNDCOLOR, 0x00FF0000L
  PRESPARAMS PP_FONTNAMESIZE, "10.System Proportional"
  MENUITEM "Two params", 1
END

ACCELTABLE 1
BEGIN
  "S", 101, CONTROL
  "s", 102
  "^G", 103
  "x", 104, CHAR, ALT
  VK_F1, 105, VIRTUALKEY, HELP
  VK_F3, 106, VIRTUALKEY
  VK_DELETE, 107, VIRTUALKEY, SHIFT
  0x3b, 108, SCANCODE, LONEKEY
  65, 109, CHAR
  "a", 110, SYSCOMMAND
  VK_TAB, 111, AF_VIRTUALKEY | AF_ALT
  "Q", 112, CONTROL, SHIFT
END

ACCELTABLE 2 PRELOAD
BEGIN
  VK_ESC, 1, VIRTUALKEY
END

ACCELTABLE 3 DISCARDABLE
BEGIN
  VK_ESC, 1, VIRTUALKEY
END

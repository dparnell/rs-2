/* Dialog templates: every control statement with its default style,
   with a style given, and with NOT. */
#include <os2.h>

DLGTEMPLATE 1
BEGIN
  DIALOG "Defaults", 1, 10, 20, 200, 150
  BEGIN
    PUSHBUTTON "Push", 101, 1, 2, 30, 12
    DEFPUSHBUTTON "Def", 102, 1, 2, 30, 12
    CHECKBOX "Check", 103, 1, 2, 30, 12
    AUTOCHECKBOX "Auto", 104, 1, 2, 30, 12
    RADIOBUTTON "Radio", 105, 1, 2, 30, 12
    AUTORADIOBUTTON "ARadio", 106, 1, 2, 30, 12
    LTEXT "Left", 107, 1, 2, 30, 12
    CTEXT "Center", 108, 1, 2, 30, 12
    RTEXT "Right", 109, 1, 2, 30, 12
    GROUPBOX "Group", 110, 1, 2, 30, 12
    ENTRYFIELD "Entry", 111, 1, 2, 30, 12
    EDITTEXT "Edit", 112, 1, 2, 30, 12
    LISTBOX 113, 1, 2, 30, 12
    COMBOBOX "Combo", 114, 1, 2, 30, 12
    ICON 5, 115, 1, 2, 0, 0
    MLE "Mle", 116, 1, 2, 30, 12
    SPINBUTTON 117, 1, 2, 30, 12
    VALUESET 118, 1, 2, 30, 12
    NOTEBOOK 119, 1, 2, 30, 12
    CONTAINER 120, 1, 2, 30, 12
    SLIDER 121, 1, 2, 30, 12
    CONTROL "Ctl", 122, 1, 2, 30, 12, WC_BUTTON
    CONTROL "Ctl2", 123, 1, 2, 30, 12, "MyClass", 0x55
    CONTROL 7, 124, 1, 2, 30, 12, WC_STATIC, SS_BITMAP
  END
END

DLGTEMPLATE 2 PRELOAD
BEGIN
  DIALOG "Styles", 2, -10, -20, 200, 150, WS_VISIBLE, FCF_TITLEBAR | FCF_SYSMENU
  BEGIN
    PUSHBUTTON "Push", 101, 1, 2, 30, 12, BS_HELP | BS_NOPOINTERFOCUS
    DEFPUSHBUTTON "Def", 102, 1, 2, 30, 12, WS_GROUP
    CHECKBOX "Check", 103, 1, 2, 30, 12, WS_DISABLED
    AUTOCHECKBOX "Auto", 104, 1, 2, 30, 12, 0
    RADIOBUTTON "Radio", 105, 1, 2, 30, 12, WS_TABSTOP
    AUTORADIOBUTTON "ARadio", 106, 1, 2, 30, 12, WS_GROUP | WS_TABSTOP
    LTEXT "Left", 107, 1, 2, 30, 12, DT_VCENTER
    CTEXT "Center", 108, 1, 2, 30, 12, DT_WORDBREAK
    RTEXT "Right", 109, 1, 2, 30, 12, DT_BOTTOM
    GROUPBOX "Group", 110, 1, 2, 30, 12, DT_MNEMONIC
    ENTRYFIELD "Entry", 111, 1, 2, 30, 12, ES_MARGIN
    LISTBOX 113, 1, 2, 30, 12, LS_HORZSCROLL
    COMBOBOX "Combo", 114, 1, 2, 30, 12, CBS_DROPDOWN
    ICON 5, 115, 1, 2, 0, 0, SS_SYSICON
    MLE "Mle", 116, 1, 2, 30, 12, MLS_WORDWRAP | MLS_VSCROLL
    SPINBUTTON 117, 1, 2, 30, 12, SPBS_NUMERICONLY
    VALUESET 118, 1, 2, 30, 12, VS_ICON
    NOTEBOOK 119, 1, 2, 30, 12, BKS_SPIRALBIND
    CONTAINER 120, 1, 2, 30, 12, CCS_MULTIPLESEL
    SLIDER 121, 1, 2, 30, 12, SLS_VERTICAL
  END
END

DLGTEMPLATE 3
BEGIN
  DIALOG "Not", 3, 0, 0, 100, 100, NOT WS_SAVEBITS | WS_VISIBLE
  BEGIN
    PUSHBUTTON "Push", 101, 1, 2, 30, 12, NOT WS_TABSTOP
    LTEXT "Left", 107, 1, 2, 30, 12, NOT WS_GROUP | DT_RIGHT
    ENTRYFIELD "Entry", 111, 1, 2, 30, 12, NOT ES_AUTOSCROLL | ES_MARGIN
    SPINBUTTON 117, 1, 2, 30, 12, NOT WS_VISIBLE
    CONTROL "c", 122, 1, 2, 30, 12, WC_BUTTON, NOT WS_VISIBLE
    COMBOBOX "Combo", 114, 1, 2, 30, 12, NOT CBS_SIMPLE | CBS_DROPDOWNLIST
  END
END

DLGTEMPLATE 4
BEGIN
  DIALOG "Borders", 4, 0, 0, 100, 100, FS_BORDER
  BEGIN
  END
END

DLGTEMPLATE 5
BEGIN
  DIALOG "Borders", 5, 0, 0, 100, 100, 0, FCF_BORDER
  BEGIN
    LTEXT "a", 1, 0, 0, 1, 1
  END
END

DLGTEMPLATE 6
BEGIN
  DIALOG "", 6, 0, 0, 100, 100, FS_MOUSEALIGN, FCF_DLGBORDER | FCF_NOBYTEALIGN
  BEGIN
    LTEXT "a", 1, 0, 0, 1, 1
  END
END

DLGTEMPLATE 7
BEGIN
  DIALOG "Data", 7, 0, 0, 100, 100
    PRESPARAMS PP_FONTNAMESIZE, "8.Helv"
  BEGIN
    LTEXT "a", 1, 0, 0, 1, 1
      PRESPARAMS PP_FOREGROUNDCOLOR, 0x00FF00L
      PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_BLUE
    CONTROL "b", 2, 0, 0, 1, 1, "MYCLASS", 0
      CTLDATA 1, 2, 3
    CONTROL "c", 3, 0, 0, 1, 1, "MYCLASS", 0
      CTLDATA "text"
      PRESPARAMS PP_FONTNAMESIZE, "10.Courier"
    CONTROL "d", 4, 0, 0, 1, 1, "MYCLASS", 0
      CTLDATA MENU
      BEGIN
        MENUITEM "Exit", 101
      END
    CONTROL "e", 5, 0, 0, 1, 1, WC_STATIC, SS_TEXT
      PRESPARAMS PP_FONTNAMESIZE, 0x65482E38, 0x766C
  END
END

DLGTEMPLATE "NAMED" DISCARDABLE
BEGIN
  DIALOG "n", 8, 0, 0, 10, 10
  BEGIN
  END
END

/* Window templates: FRAME, WINDOW and nesting. */
#include <os2.h>

WINDOWTEMPLATE 1
BEGIN
  FRAME "My Window", 1, 10, 10, 320, 130, 0, FCF_STANDARD | FCF_VERTSCROLL
  BEGIN
    WINDOW "", FID_CLIENT, 0, 0, 0, 0, "MyClientClass"
  END
END

WINDOWTEMPLATE 2
BEGIN
  FRAME "", 2, 10, 10, 320, 130
  BEGIN
    WINDOW "Client", FID_CLIENT, 0, 0, 100, 100, "Cls", WS_VISIBLE
    BEGIN
      CONTROL "Inner", 5, 1, 1, 10, 10, WC_BUTTON, BS_PUSHBUTTON | WS_VISIBLE
      BEGIN
        CONTROL "Innermost", 6, 1, 1, 10, 10, WC_STATIC, SS_TEXT
      END
      PUSHBUTTON "P", 7, 1, 1, 10, 10
    END
  END
END

WINDOWTEMPLATE 3 PRELOAD
BEGIN
  WINDOW "Top", 3, 0, 0, 10, 10, WC_FRAME, WS_VISIBLE, FCF_TITLEBAR
  BEGIN
    DIALOG "Inner dialog", 4, 0, 0, 5, 5
    BEGIN
    END
  END
END

WINDOWTEMPLATE 4
BEGIN
  FRAME "Styled", 4, 1, 2, 3, 4, FS_SIZEBORDER | WS_VISIBLE
END

DLGTEMPLATE 5
BEGIN
  FRAME "Frame in dlg", 5, 1, 2, 3, 4, FS_DLGBORDER, FCF_TITLEBAR
  BEGIN
    LTEXT "x", 1, 0, 0, 1, 1
  END
END

WINDOWTEMPLATE 6
BEGIN
  WINDOW "w", 6, 1, 2, 3, 4, WC_ENTRYFIELD
END

/* Load and memory options, file resources, data resources, strings. */
#include <os2.h>
#include "t.h"

POINTER 2 PRELOAD T.PTR
POINTER 3 T.PTR
BITMAP 3 LOADONCALL FIXED T.BMP
BITMAP 4 MOVEABLE T.BMP
BITMAP 5 DISCARDABLE T.BMP
BITMAP 6 PRELOAD MOVEABLE DISCARDABLE T.BMP
BITMAP 7 FIXED PRELOAD T.BMP
BITMAP 8 IMPURE T.BMP
BITMAP 9 PURE FIXED T.BMP
BITMAP 10 FIXED DISCARDABLE T.BMP
BITMAP 11 DISCARDABLE FIXED T.BMP
BITMAP 12 B4096.BMP
BITMAP 13 B4097.BMP
BITMAP 14 PRELOAD B4097.BMP
POINTER 15 B4097.BMP
BITMAP (TH_ONE + 20) "T.BMP"
BITMAP 0x20 t.bmp

RESOURCE 300 1 T.DAT
RESOURCE 300 2 PRELOAD
BEGIN
  "abc", "de\0f", 1, 2L, -1, 0x12345, 65535, 65536
END
RESOURCE 301 1 FIXED T.DAT
RESOURCE 0x7fff 3 DISCARDABLE T.DAT

RCDATA 10
BEGIN
  "abc", "de\0f", 1, 2L, -1, 0x12345, 010, 08, 3+4*2, (5), 0x10L, 077L, -2L
END
RCDATA 11 PRELOAD FIXED
BEGIN
  1 2 3 "x" "y"
  "z" 4
END
RCDATA 12 DISCARDABLE BEGIN 10L | 1, 7 / 2, -(3), 3 + 4 * 2, (2) END

DLGINCLUDE 1 T.H
DLGINCLUDE 2 "SUB\\X.H"
DLGINCLUDE 3 sub\y.h

CODEPAGE 437
STRINGTABLE
BEGIN
  1 "one"
  2, "two\ttab"
  17 "seventeen"
  0 "zero"
  3 "with ""quotes"" in it"
  4 "esc \a\b\f\n\r\v\'\"\?\\ \101\x42 end"
  5 "joined " "string"
  6 "two
lines"
END
CODEPAGE 850
STRINGTABLE PRELOAD
BEGIN
  32 "x"
  18 "eighteen"
  0x30, "hex id"
END
STRINGTABLE FIXED
BEGIN
  100 "hundred"
END
MESSAGETABLE
BEGIN
  5 "m5"
  100 "m100"
  21, "m21"
END
MESSAGETABLE PRELOAD
BEGIN
  6 "m6"
END

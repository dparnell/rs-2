+//===--- RS2.cpp - rs2 (64-bit OS/2 API) ToolChain --------------*- C++ -*-===//
+//
+// Part of rs2's LLVM patch (userland64/llvm/rs2.patch). Compiles and links
+// as rs2's userland64/c/cc64.sh does. The SDK is the directory above the
+// one clang is in, or --sysroot: include, include/c++/{config,v1,abi}, lib.
+//
+//===----------------------------------------------------------------------===//
+
+#include "RS2.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Driver/Options.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Path.h"
+
+using namespace clang::driver;
+using namespace clang::driver::tools;
+using namespace clang::driver::toolchains;
+using namespace clang;
+using namespace llvm::opt;
+
+void rs2::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                               const InputInfo &Output,
+                               const InputInfoList &Inputs,
+                               const ArgList &Args,
+                               const char *LinkingOutput) const {
+  const auto &TC = static_cast<const toolchains::RS2 &>(getToolChain());
+  const Driver &D = TC.getDriver();
+  ArgStringList CmdArgs;
+  auto Lib = [&](StringRef Name) {
+    return Args.MakeArgString(TC.sysRootPath("lib", Name));
+  };
+
+  Args.ClaimAllArgs(options::OPT_g_Group);
+  Args.ClaimAllArgs(options::OPT_emit_llvm);
+  Args.ClaimAllArgs(options::OPT_w);
+  Args.ClaimAllArgs(options::OPT_pie);
+  Args.ClaimAllArgs(options::OPT_stdlib_EQ);
+  Args.claimAllArgs(options::OPT_pthread, options::OPT_pthreads);
+
+  CmdArgs.append({"-flavor", "gnu"});
+  const char *Exec = Args.MakeArgString(TC.GetLinkerPath());
+  if (Args.hasArg(options::OPT_r)) {
+    CmdArgs.append({"-r", "-o", Output.getFilename()});
+    AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+    C.addCommand(std::make_unique<Command>(
+        JA, *this, ResponseFileSupport::AtFileCurCP(), Exec, CmdArgs, Inputs,
+        Output));
+    return;
+  }
+
+  const bool Shared = Args.hasArg(options::OPT_shared);
+  const bool Static = Args.hasArg(options::OPT_static);
+  // Programs and DLLs are both ELF shared objects to the linker.
+  CmdArgs.push_back("-shared");
+  if (!Args.hasArg(options::OPT_T))
+    CmdArgs.append({"-T", Lib("link64.ld")});
+  CmdArgs.append({"--no-rosegment", "-nostdlib", "-z", "now", "-z", "norelro",
+                  "-Bsymbolic", "--hash-style=sysv", "--gc-sections",
+                  "--eh-frame-hdr", "--exclude-libs=ALL", "--as-needed",
+                  "--rs2-imports"});
+  CmdArgs.append({"--export-dynamic-symbol=RS2_APPTYPE",
+                  "--export-dynamic-symbol=RS2_RESOURCES"});
+  if (Shared) {
+    // What a module that needs this DLL calls it.
+    std::string Name =
+        llvm::sys::path::filename(Output.getFilename()).upper();
+    if (StringRef(Name).ends_with(".DLL"))
+      Name.resize(Name.size() - 4);
+    CmdArgs.push_back(Args.MakeArgString("-soname=" + Name));
+  }
+  CmdArgs.append({"-o", Output.getFilename()});
+
+  if (!Args.hasArg(options::OPT_nostdlib, options::OPT_nostartfiles)) {
+    if (Args.hasArg(options::OPT_mwindows))
+      CmdArgs.push_back(Lib("pmapp.o"));
+    if (Shared)
+      CmdArgs.append({Lib("dllstart.o"), Lib("crtdll.o")});
+    else if (!Static)
+      CmdArgs.push_back(Lib("crt1.o"));
+  } else {
+    Args.ClaimAllArgs(options::OPT_mwindows);
+  }
+
+  Args.addAllArgs(CmdArgs, {options::OPT_L, options::OPT_T_Group,
+                            options::OPT_s, options::OPT_t});
+  CmdArgs.push_back(Args.MakeArgString("-L" + TC.sysRootPath("lib")));
+  AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+
+  if (!Args.hasArg(options::OPT_nostdlib, options::OPT_nodefaultlibs)) {
+    if (D.CCCIsCXX() && TC.ShouldLinkCXXStdlib(Args))
+      CmdArgs.push_back(Lib(Static ? "libcxx64s.a" : "LIBCXX64.DLL"));
+    if (!Args.hasArg(options::OPT_nolibc))
+      CmdArgs.push_back(Lib(Static ? "libc.a" : "libc64.a"));
+  }
+
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
+
+RS2::RS2(const Driver &D, const llvm::Triple &Triple, const ArgList &Args)
+    : ToolChain(D, Triple, Args) {
+  getProgramPaths().push_back(D.Dir);
+  getFilePaths().push_back(sysRootPath("lib"));
+}
+
+std::string RS2::computeSysRoot() const {
+  if (!getDriver().SysRoot.empty())
+    return getDriver().SysRoot;
+  return llvm::sys::path::parent_path(getDriver().Dir).str();
+}
+
+std::string RS2::sysRootPath(StringRef A, StringRef B, StringRef C) const {
+  SmallString<128> P(computeSysRoot());
+  for (StringRef S : {A, B, C})
+    if (!S.empty())
+      llvm::sys::path::append(P, S);
+  return std::string(P);
+}
+
+void RS2::addClangTargetOptions(const ArgList &DriverArgs,
+                                ArgStringList &CC1Args,
+                                Action::OffloadKind) const {
+  if (!DriverArgs.hasArg(options::OPT_fvisibility_EQ))
+    CC1Args.push_back("-fvisibility=hidden");
+  if (!DriverArgs.hasArg(options::OPT_fvisibility_inlines_hidden,
+                         options::OPT_fno_visibility_inlines_hidden))
+    CC1Args.push_back("-fvisibility-inlines-hidden");
+  if (!DriverArgs.hasArg(options::OPT_fplt, options::OPT_fno_plt))
+    CC1Args.push_back("-fno-plt");
+  // Stacks grow over a guard page.
+  if (!DriverArgs.hasArg(options::OPT_fstack_clash_protection,
+                         options::OPT_fno_stack_clash_protection))
+    CC1Args.push_back("-fstack-clash-protection");
+  if (!DriverArgs.hasArg(options::OPT_static))
+    CC1Args.push_back("-D_RS2_LIBC_DLL");
+}
+
+void RS2::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                    ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+  // rs2's C headers come before clang's.
+  if (!DriverArgs.hasArg(options::OPT_nostdlibinc))
+    addSystemInclude(DriverArgs, CC1Args, sysRootPath("include"));
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> P(getDriver().ResourceDir);
+    llvm::sys::path::append(P, "include");
+    addSystemInclude(DriverArgs, CC1Args, P);
+  }
+}
+
+void RS2::AddClangCXXStdlibIncludeArgs(const ArgList &DriverArgs,
+                                       ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc, options::OPT_nostdlibinc,
+                        options::OPT_nostdincxx))
+    return;
+  for (const char *Dir : {"config", "v1", "abi"})
+    addSystemInclude(DriverArgs, CC1Args, sysRootPath("include", "c++", Dir));
+}
+
+Tool *RS2::buildLinker() const { return new tools::rs2::Linker(*this); }

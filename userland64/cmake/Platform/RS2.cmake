# The rs2 platform: what is Unix-like of it, and how to link.
set(UNIX 1)
set(CMAKE_EXECUTABLE_SUFFIX ".EXE")
set(CMAKE_SHARED_LIBRARY_PREFIX "")
set(CMAKE_SHARED_LIBRARY_SUFFIX ".DLL")
set(CMAKE_STATIC_LIBRARY_PREFIX "lib")
set(CMAKE_STATIC_LIBRARY_SUFFIX ".a")
set(CMAKE_DL_LIBS "")
set(CMAKE_FIND_LIBRARY_PREFIXES "lib")
set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
foreach(lang C CXX)
  set(CMAKE_${lang}_LINK_LIBRARY_SUFFIX "")
  set(CMAKE_${lang}_ARCHIVE_CREATE "<CMAKE_AR> rc <TARGET> <OBJECTS>")
  set(CMAKE_${lang}_ARCHIVE_APPEND "<CMAKE_AR> r <TARGET> <OBJECTS>")
  set(CMAKE_${lang}_ARCHIVE_FINISH "<CMAKE_AR> s <TARGET>")
endforeach()
set(CMAKE_C_LINK_EXECUTABLE "${RS2_CC} -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "${RS2_CC} --cxx -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")

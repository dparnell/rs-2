# Exception handling for 64-bit code (docs/API64.md, "Exceptions"): the
# 64-bit registration, report and context records.

include os2def

const XCPT_CONTINUE_SEARCH 0x00000000
const XCPT_CONTINUE_EXECUTION 0xffffffff
const XCPT_CONTINUE_STOP 0x00716668
const EH_NONCONTINUABLE 0x01
const EH_UNWINDING 0x02
const EH_EXIT_UNWIND 0x04
const EH_STACK_INVALID 0x08
const EH_NESTED_CALL 0x10
const XCPT_GUARD_PAGE_VIOLATION 0x80000001
const XCPT_UNABLE_TO_GROW_STACK 0x80010001
const XCPT_ACCESS_VIOLATION 0xC0000005
const XCPT_IN_PAGE_ERROR 0xC0000006
const XCPT_ILLEGAL_INSTRUCTION 0xC000001C
const XCPT_INVALID_LOCK_SEQUENCE 0xC000001D
const XCPT_NONCONTINUABLE_EXCEPTION 0xC0000024
const XCPT_INVALID_DISPOSITION 0xC0000025
const XCPT_UNWIND 0xC0000026
const XCPT_BAD_STACK 0xC0000027
const XCPT_INVALID_UNWIND_TARGET 0xC0000028
const XCPT_ARRAY_BOUNDS_EXCEEDED 0xC0000093
const XCPT_FLOAT_DENORMAL_OPERAND 0xC0000094
const XCPT_FLOAT_DIVIDE_BY_ZERO 0xC0000095
const XCPT_FLOAT_INEXACT_RESULT 0xC0000096
const XCPT_FLOAT_INVALID_OPERATION 0xC0000097
const XCPT_FLOAT_OVERFLOW 0xC0000098
const XCPT_FLOAT_STACK_CHECK 0xC0000099
const XCPT_FLOAT_UNDERFLOW 0xC000009A
const XCPT_INTEGER_DIVIDE_BY_ZERO 0xC000009B
const XCPT_INTEGER_OVERFLOW 0xC000009C
const XCPT_PRIVILEGED_INSTRUCTION 0xC000009D
const XCPT_DATATYPE_MISALIGNMENT 0xC000009E
const XCPT_BREAKPOINT 0xC000009F
const XCPT_SINGLE_STEP 0xC00000A0
const XCPT_PROCESS_TERMINATE 0xC0010001
const XCPT_ASYNC_PROCESS_TERMINATE 0xC0010002
const XCPT_SIGNAL 0xC0010003
const XCPT_READ_ACCESS 0x00000001
const XCPT_WRITE_ACCESS 0x00000002
const XCPT_EXECUTE_ACCESS 0x00000004
const XCPT_UNKNOWN_ACCESS 0x00000000
const XCPT_SIGNAL_INTR 1
const XCPT_SIGNAL_KILLPROC 3
const XCPT_SIGNAL_BREAK 4
const CONTEXT_CONTROL 0x00000001
const CONTEXT_INTEGER 0x00000002
const CONTEXT_SEGMENTS 0x00000004
const CONTEXT_FLOATING_POINT 0x00000008
const CONTEXT_FULL 0x00000007

struct EXCEPTIONREPORTRECORD
  ULONG ExceptionNum
  ULONG fHandlerFlags
  PVOID NestedExceptionReportRecord
  PVOID ExceptionAddress
  ULONG cParameters
  ULONG reserved
  ULONG_PTR ExceptionInfo[4]
end

# The floating point state (fxsave) is not filled yet.
struct CONTEXTRECORD
  ULONG ContextFlags
  ULONG reserved
  ULONGLONG ctx_RegRax
  ULONGLONG ctx_RegRbx
  ULONGLONG ctx_RegRcx
  ULONGLONG ctx_RegRdx
  ULONGLONG ctx_RegRsi
  ULONGLONG ctx_RegRdi
  ULONGLONG ctx_RegRbp
  ULONGLONG ctx_RegRsp
  ULONGLONG ctx_RegR8
  ULONGLONG ctx_RegR9
  ULONGLONG ctx_RegR10
  ULONGLONG ctx_RegR11
  ULONGLONG ctx_RegR12
  ULONGLONG ctx_RegR13
  ULONGLONG ctx_RegR14
  ULONGLONG ctx_RegR15
  ULONGLONG ctx_RegRip
  ULONGLONG ctx_EFlags
  ULONG ctx_SegCs
  ULONG ctx_SegSs
  ULONG ctx_SegDs
  ULONG ctx_SegEs
  ULONG ctx_SegFs
  ULONG ctx_SegGs
  ULONG reserved2[4]
  BYTE ctx_fxsave[512]
end

c
struct _EXCEPTIONREGISTRATIONRECORD;
typedef ULONG _ERR(PEXCEPTIONREPORTRECORD, struct _EXCEPTIONREGISTRATIONRECORD *, PCONTEXTRECORD, PVOID);
typedef _ERR *PFNXCPTHANDLER;
typedef struct _EXCEPTIONREGISTRATIONRECORD {
    struct _EXCEPTIONREGISTRATIONRECORD *prev_structure;
    PFNXCPTHANDLER ExceptionHandler;
} EXCEPTIONREGISTRATIONRECORD, *PEXCEPTIONREGISTRATIONRECORD;
/* The end of the chain: all 64 bits set. */
#define END_OF_CHAIN ((PEXCEPTIONREGISTRATIONRECORD)(ULONG_PTR)-1)
end

rust
pub type PFNXCPTHANDLER = Option<unsafe extern "C" fn(PEXCEPTIONREPORTRECORD, PEXCEPTIONREGISTRATIONRECORD, PCONTEXTRECORD, PVOID) -> ULONG>;
#[repr(C)]
#[derive(Clone, Copy)]
pub struct EXCEPTIONREGISTRATIONRECORD {
    pub prev_structure: PEXCEPTIONREGISTRATIONRECORD,
    pub ExceptionHandler: PFNXCPTHANDLER,
}
pub type PEXCEPTIONREGISTRATIONRECORD = *mut EXCEPTIONREGISTRATIONRECORD;
/// The end of the chain: all 64 bits set.
pub const END_OF_CHAIN: PEXCEPTIONREGISTRATIONRECORD = usize::MAX as PEXCEPTIONREGISTRATIONRECORD;
end

fn DOSCALLS.354 APIRET DosSetExceptionHandler(PEXCEPTIONREGISTRATIONRECORD pERegRec)
fn DOSCALLS.355 APIRET DosUnsetExceptionHandler(PEXCEPTIONREGISTRATIONRECORD pERegRec)
fn DOSCALLS.356 APIRET DosRaiseException(PEXCEPTIONREPORTRECORD pexcept)
fn DOSCALLS.357 APIRET DosUnwindException(PEXCEPTIONREGISTRATIONRECORD phandler, PVOID pTargetIP, PEXCEPTIONREPORTRECORD pERepRec)

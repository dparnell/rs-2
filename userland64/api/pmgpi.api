const BBO_IGNORE 2
const BBO_PAL_COLORS 4
const BBO_NO_COLOR_INFO 8
const CBM_INIT 0x0004
const HBM_ERROR -1 : LONG

struct BITMAPINFOHEADER2
  ULONG cbFix
  ULONG cx
  ULONG cy
  USHORT cPlanes
  USHORT cBitCount
  ULONG ulCompression
  ULONG cbImage
  ULONG cxResolution
  ULONG cyResolution
  ULONG cclrUsed
  ULONG cclrImportant
  USHORT usUnits
  USHORT usReserved
  USHORT usRecording
  USHORT usRendering
  ULONG cSize1
  ULONG cSize2
  ULONG ulColorEncoding
  ULONG ulIdentifier
end

struct RGB2
  BYTE bBlue
  BYTE bGreen
  BYTE bRed
  BYTE fcOptions
end

struct BITMAPINFO2
  ULONG cbFix
  ULONG cx
  ULONG cy
  USHORT cPlanes
  USHORT cBitCount
  ULONG ulCompression
  ULONG cbImage
  ULONG cxResolution
  ULONG cyResolution
  ULONG cclrUsed
  ULONG cclrImportant
  USHORT usUnits
  USHORT usReserved
  USHORT usRecording
  USHORT usRendering
  ULONG cSize1
  ULONG cSize2
  ULONG ulColorEncoding
  ULONG ulIdentifier
  RGB2 argbColor[1]
end

fn PMWIN HBITMAP GpiCreateBitmap(HPS hps, PBITMAPINFOHEADER2 pbmpNew, ULONG flOptions, PBYTE pbInitData, PBITMAPINFO2 pbmiInfoTable)
fn PMWIN BOOL GpiDeleteBitmap(HBITMAP hbm)

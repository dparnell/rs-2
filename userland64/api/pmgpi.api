# DEVOPENSTRUC is an array of pointers: the 64-bit PMWIN passes it on
# converted (docs/API64.md).
struct DEVOPENSTRUC
  PSZ pszLogAddress
  PSZ pszDriverName
  PVOID pdriv
  PSZ pszDataType
  PSZ pszComment
  PSZ pszQueueProcName
  PSZ pszQueueProcParams
  PSZ pszSpoolerParams
  PSZ pszNetworkParams
end
type DEVOPENDATA PVOID

fn PMWIN HDC DevOpenDC(HAB hab, LONG lType, PCSZ pszToken, LONG lCount, DEVOPENDATA pdopData, HDC hdcComp)
fn PMWIN HMODULE DevCloseDC(HDC hdc)
fn PMWIN BOOL DevQueryCaps(HDC hdc, LONG lStart, LONG lCount, PLONG alArray)

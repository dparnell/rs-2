# The system window classes, as their "#n" names.
c
#define WC_FRAME ((PCSZ)0xffff0001)
#define WC_COMBOBOX ((PCSZ)0xffff0002)
#define WC_BUTTON ((PCSZ)0xffff0003)
#define WC_MENU ((PCSZ)0xffff0004)
#define WC_STATIC ((PCSZ)0xffff0005)
#define WC_ENTRYFIELD ((PCSZ)0xffff0006)
#define WC_LISTBOX ((PCSZ)0xffff0007)
#define WC_SCROLLBAR ((PCSZ)0xffff0008)
#define WC_TITLEBAR ((PCSZ)0xffff0009)
#define WC_MLE ((PCSZ)0xffff000a)
#define WC_SPINBUTTON ((PCSZ)0xffff0020)
#define WC_CONTAINER ((PCSZ)0xffff0025)
#define WC_SLIDER ((PCSZ)0xffff0026)
#define WC_VALUESET ((PCSZ)0xffff0027)
#define WC_NOTEBOOK ((PCSZ)0xffff0028)
end
rust

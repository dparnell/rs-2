fn PMWIN BOOL WinRegisterClass(HAB hab, PCSZ pszClassName, PFNWP pfnWndProc, ULONG flStyle, ULONG cbWindowData)
fn PMWIN BOOL WinQueryClassInfo(HAB hab, PCSZ pszClassName, PCLASSINFO pClassInfo)
fn PMWIN LONG WinQueryClassName(HWND hwnd, LONG cchMax, PCH pch)
fn PMWIN HWND WinCreateWindow(HWND hwndParent, PCSZ pszClass, PCSZ pszName, ULONG flStyle, LONG x, LONG y, LONG cx, LONG cy, HWND hwndOwner, HWND hwndInsertBehind, ULONG id, PVOID pCtlData, PVOID pPresParams)
fn PMWIN BOOL WinDestroyWindow(HWND hwnd)
fn PMWIN BOOL WinShowWindow(HWND hwnd, BOOL fShow)
fn PMWIN BOOL WinEnableWindow(HWND hwnd, BOOL fEnable)
fn PMWIN BOOL WinEnableWindowUpdate(HWND hwnd, BOOL fEnable)
fn PMWIN BOOL WinIsWindow(HAB hab, HWND hwnd)
fn PMWIN BOOL WinIsWindowEnabled(HWND hwnd)
fn PMWIN BOOL WinIsWindowVisible(HWND hwnd)
fn PMWIN BOOL WinIsChild(HWND hwnd, HWND hwndParent)

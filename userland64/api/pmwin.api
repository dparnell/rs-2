c
#define WinCheckButton(hwndDlg, id, usChkstate) ((ULONG)(ULONG_PTR)WinSendDlgItemMsg(hwndDlg, id, BM_SETCHECK, MPFROMSHORT(usChkstate), (MPARAM)0))
#define WinQueryButtonCheckstate(hwndDlg, id) ((ULONG)(ULONG_PTR)WinSendDlgItemMsg(hwndDlg, id, BM_QUERYCHECK, (MPARAM)0, (MPARAM)0))
#define WinEnableControl(hwndDlg, id, fEnable) WinEnableWindow(WinWindowFromID(hwndDlg, id), fEnable)
#define WinIsControlEnabled(hwndDlg, id) WinIsWindowEnabled(WinWindowFromID(hwndDlg, id))
#define WinInsertLboxItem(hwndLbox, index, psz) ((LONG)(ULONG_PTR)WinSendMsg(hwndLbox, LM_INSERTITEM, MPFROMLONG(index), MPFROMP(psz)))
#define WinQueryLboxCount(hwndLbox) ((LONG)(ULONG_PTR)WinSendMsg(hwndLbox, LM_QUERYITEMCOUNT, (MPARAM)0, (MPARAM)0))
#define WinQueryLboxSelectedItem(hwndLbox) ((LONG)(ULONG_PTR)WinSendMsg(hwndLbox, LM_QUERYSELECTION, MPFROMLONG(LIT_FIRST), (MPARAM)0))
#define WinDeleteLboxItem(hwndLbox, index) ((LONG)(ULONG_PTR)WinSendMsg(hwndLbox, LM_DELETEITEM, MPFROMLONG(index), (MPARAM)0))
#define WinCheckMenuItem(hwndMenu, id, fcheck) ((BOOL)(ULONG_PTR)WinSendMsg(hwndMenu, MM_SETITEMATTR, MPFROM2SHORT(id, TRUE), MPFROM2SHORT(MIA_CHECKED, (fcheck) ? MIA_CHECKED : 0)))
#define WinEnableMenuItem(hwndMenu, id, fEnable) ((BOOL)(ULONG_PTR)WinSendMsg(hwndMenu, MM_SETITEMATTR, MPFROM2SHORT(id, TRUE), MPFROM2SHORT(MIA_DISABLED, (fEnable) ? 0 : MIA_DISABLED)))
#define WinIsMenuItemChecked(hwndMenu, id) ((BOOL)(ULONG_PTR)WinSendMsg(hwndMenu, MM_QUERYITEMATTR, MPFROM2SHORT(id, TRUE), MPFROMLONG(MIA_CHECKED)))
end

rust
/// WinCheckButton and friends of the C headers (macros there).
pub unsafe fn WinCheckButton(hwnd_dlg: HWND, id: ULONG, state: USHORT) -> ULONG {
    unsafe { longfrommr(WinSendDlgItemMsg(hwnd_dlg, id, BM_SETCHECK, mpfromshort(state), core::ptr::null_mut())) }
}
pub unsafe fn WinQueryButtonCheckstate(hwnd_dlg: HWND, id: ULONG) -> ULONG {
    unsafe { longfrommr(WinSendDlgItemMsg(hwnd_dlg, id, BM_QUERYCHECK, core::ptr::null_mut(), core::ptr::null_mut())) }
}
pub unsafe fn WinEnableControl(hwnd_dlg: HWND, id: ULONG, enable: BOOL) -> BOOL {
    unsafe { WinEnableWindow(WinWindowFromID(hwnd_dlg, id), enable) }
}
pub unsafe fn WinInsertLboxItem(hwnd: HWND, index: LONG, text: PCSZ) -> LONG {
    unsafe { longfrommr(WinSendMsg(hwnd, LM_INSERTITEM, mpfromlong(index as u32), text as MPARAM)) as LONG }
}
pub unsafe fn WinQueryLboxCount(hwnd: HWND) -> LONG {
    unsafe { longfrommr(WinSendMsg(hwnd, LM_QUERYITEMCOUNT, core::ptr::null_mut(), core::ptr::null_mut())) as LONG }
}
pub unsafe fn WinQueryLboxSelectedItem(hwnd: HWND) -> LONG {
    unsafe { longfrommr(WinSendMsg(hwnd, LM_QUERYSELECTION, mpfromlong(LIT_FIRST as i32 as u32), core::ptr::null_mut())) as i16 as LONG }
}
pub unsafe fn WinCheckMenuItem(hwnd_menu: HWND, id: USHORT, check: bool) -> BOOL {
    let attr = MIA_CHECKED as u16;
    unsafe { longfrommr(WinSendMsg(hwnd_menu, MM_SETITEMATTR, mpfrom2short(id, 1), mpfrom2short(attr, if check { attr } else { 0 }))) }
}
pub unsafe fn WinEnableMenuItem(hwnd_menu: HWND, id: USHORT, enable: bool) -> BOOL {
    let attr = MIA_DISABLED as u16;
    unsafe { longfrommr(WinSendMsg(hwnd_menu, MM_SETITEMATTR, mpfrom2short(id, 1), mpfrom2short(attr, if enable { 0 } else { attr }))) }
}
end


# The window manager for 64-bit programs: the 64-bit PMWIN
# (C:\RS2\DLL64\PMWIN.DLL), which passes each call on to rs2's 32-bit
# PMWIN (docs/API64.md, "PM for 64-bit programs"). Window and dialog
# procedures are System V functions with 64-bit MPARAMs.

include os2def

fnptr PFNWP MRESULT (HWND, ULONG, MPARAM, MPARAM)

# ---- Anchor blocks, queues, messages ----

const HWND_DESKTOP 1 : HWND
const HWND_OBJECT 2 : HWND
const HWND_TOP 3 : HWND
const HWND_BOTTOM 4 : HWND
const HWND_THREADCAPTURE 5 : HWND
const PM_REMOVE 0x0001
const PM_NOREMOVE 0x0000

# QMSG: 40 bytes (MPARAMs are 64 bits).
struct QMSG
  HWND hwnd
  ULONG msg
  MPARAM mp1
  MPARAM mp2
  ULONG time
  POINTL ptl
  ULONG reserved
end

fn PMWIN HAB WinInitialize(ULONG flOptions)
fn PMWIN BOOL WinTerminate(HAB hab)
fn PMWIN HAB WinQueryAnchorBlock(HWND hwnd)
fn PMWIN HMQ WinCreateMsgQueue(HAB hab, LONG cmsg)
fn PMWIN BOOL WinDestroyMsgQueue(HMQ hmq)
fn PMWIN BOOL WinGetMsg(HAB hab, PQMSG pqmsg, HWND hwndFilter, ULONG msgFilterFirst, ULONG msgFilterLast)
fn PMWIN BOOL WinPeekMsg(HAB hab, PQMSG pqmsg, HWND hwndFilter, ULONG msgFilterFirst, ULONG msgFilterLast, ULONG fl)
fn PMWIN MRESULT WinDispatchMsg(HAB hab, PQMSG pqmsg)
fn PMWIN BOOL WinPostMsg(HWND hwnd, ULONG msg, MPARAM mp1, MPARAM mp2)
fn PMWIN MRESULT WinSendMsg(HWND hwnd, ULONG msg, MPARAM mp1, MPARAM mp2)
fn PMWIN BOOL WinPostQueueMsg(HMQ hmq, ULONG msg, MPARAM mp1, MPARAM mp2)
fn PMWIN BOOL WinBroadcastMsg(HWND hwnd, ULONG msg, MPARAM mp1, MPARAM mp2, ULONG rgf)
fn PMWIN MRESULT WinDefWindowProc(HWND hwnd, ULONG msg, MPARAM mp1, MPARAM mp2)
fn PMWIN BOOL WinWaitMsg(HAB hab, ULONG msgfirst, ULONG msglast)
fn PMWIN BOOL WinQueryMsgPos(HAB hab, PPOINTL pptl)
fn PMWIN ULONG WinQueryMsgTime(HAB hab)
fn PMWIN ERRORID WinGetLastError(HAB hab)


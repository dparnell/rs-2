fn PMWIN BOOL WinSetWindowBits(HWND hwnd, LONG index, ULONG flData, ULONG flMask)
fn PMWIN PFNWP WinSubclassWindow(HWND hwnd, PFNWP pfnwp)
fn PMWIN BOOL WinQueryWindowProcess(HWND hwnd, PPID ppid, PTID ptid)
fn PMWIN BOOL WinMapWindowPoints(HWND hwndFrom, HWND hwndTo, PPOINTL prgptl, LONG cwpt)
fn PMWIN BOOL WinSetFocus(HWND hwndDesktop, HWND hwndNewFocus)
fn PMWIN HWND WinQueryFocus(HWND hwndDesktop)
fn PMWIN BOOL WinSetActiveWindow(HWND hwndDesktop, HWND hwnd)
fn PMWIN HWND WinQueryActiveWindow(HWND hwndDesktop)
fn PMWIN BOOL WinSetCapture(HWND hwndDesktop, HWND hwnd)
fn PMWIN HWND WinQueryCapture(HWND hwndDesktop)

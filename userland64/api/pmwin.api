fn PMWIN HWND WinWindowFromPoint(HWND hwnd, PPOINTL pptl, BOOL fChildren)
fn PMWIN HWND WinQueryDesktopWindow(HAB hab, ULONG hdc)
fn PMWIN HWND WinQueryObjectWindow(HWND hwndDesktop)
fn PMWIN BOOL WinSetParent(HWND hwnd, HWND hwndNewParent, BOOL fRedraw)
fn PMWIN BOOL WinSetOwner(HWND hwnd, HWND hwndNewOwner)
fn PMWIN BOOL WinQueryWindowRect(HWND hwnd, PRECTL prclDest)
fn PMWIN BOOL WinQueryWindowPos(HWND hwnd, PSWP pswp)
fn PMWIN BOOL WinSetWindowPos(HWND hwnd, HWND hwndInsertBehind, LONG x, LONG y, LONG cx, LONG cy, ULONG fl)
fn PMWIN BOOL WinSetMultWindowPos(HAB hab, PSWP pswp, ULONG cswp)
fn PMWIN BOOL WinSetWindowText(HWND hwnd, PCSZ pszText)

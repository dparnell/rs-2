# CLASSINFO and CREATESTRUCT (WM_CREATE's mp2) in their 64-bit layouts.
struct CLASSINFO
  ULONG flClassStyle
  PFNWP pfnWindowProc
  ULONG cbWindowData
end

struct CREATESTRUCT
  PVOID pPresParams
  PVOID pCtlData
  ULONG id
  HWND hwndInsertBehind
  HWND hwndOwner
  LONG cy
  LONG cx
  LONG y
  LONG x
  ULONG flStyle
  PSZ pszText
  PSZ pszClass
  HWND hwndParent
end

struct SWP
  ULONG fl
  LONG cy
  LONG cx
  LONG y
  LONG x
  HWND hwndInsertBehind
  HWND hwnd
  ULONG ulReserved1
  ULONG ulReserved2
end

const SWP_SIZE 0x0001
const SWP_MOVE 0x0002
const SWP_ZORDER 0x0004
const SWP_SHOW 0x0008

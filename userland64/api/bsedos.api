struct RESULTCODES
  ULONG codeTerminate
  ULONG codeResult
end

# The 64-bit TIB and PIB (DosGetInfoBlocks).
struct TIB2
  ULONG tib2_ultid
  ULONG tib2_ulpri
  ULONG tib2_version
  USHORT tib2_usMCCount
  USHORT tib2_fMCForceFlag
end

struct TIB
  PVOID tib_pexchain
  PVOID tib_pstack
  PVOID tib_pstacklimit
  PTIB2 tib_ptib2
  ULONG tib_version
  ULONG tib_ordinal
end

struct PIB
  ULONG pib_ulpid
  ULONG pib_ulppid
  ULONG pib_hmte
  PCHAR pib_pchcmd
  PCHAR pib_pchenv
  ULONG pib_flstatus
  ULONG pib_ultype
end

ptr PPTIB PTIB
ptr PPPIB PPIB
fnptr PFNTHREAD VOID (ULONG_PTR)

fn DOSCALLS.234 VOID DosExit(ULONG action, ULONG result)

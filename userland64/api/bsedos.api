struct FDATE
  USHORT date   # day 0-4, month 5-8, year since 1980 9-15
end

struct FTIME
  USHORT time   # twosecs 0-4, minutes 5-10, hours 11-15
end

struct FILESTATUS3
  FDATE fdateCreation
  FTIME ftimeCreation
  FDATE fdateLastAccess
  FTIME ftimeLastAccess
  FDATE fdateLastWrite
  FTIME ftimeLastWrite
  ULONG cbFile
  ULONG cbFileAlloc
  ULONG attrFile
end

struct FILELOCK
  LONG lOffset
  LONG lRange
end

struct FILEFINDBUF3
  ULONG oNextEntryOffset
  FDATE fdateCreation
  FTIME ftimeCreation
  FDATE fdateLastAccess
  FTIME ftimeLastAccess
  FDATE fdateLastWrite
  FTIME ftimeLastWrite
  ULONG cbFile
  ULONG cbFileAlloc
  ULONG attrFile
  UCHAR cchName
  CHAR achName[256]
end

struct FSALLOCATE
  ULONG idFileSystem
  ULONG cSectorUnit
  ULONG cUnit
  ULONG cUnitAvail
  USHORT cbSector
end


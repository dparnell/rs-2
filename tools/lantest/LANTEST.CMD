@ECHO OFF
REM The LAN requester from the command line (tools/scripts/lantest.sh).
ECHO === LANTEST.EXE
C:\RS2\LANTEST.EXE
ECHO === NET commands
NET START REQUESTER
NET LOGON rs2 secret
NET VIEW
NET VIEW \\SMBHOST
NET VIEW \\LMHSRV
NET USE Z: \\SMBHOST\DATA
NET USE LPT3 \\SMBHOST\LPT
NET USE
NET USE Z:
DIR Z:\
MD Z:\CMDDIR
COPY C:\CONFIG.SYS Z:\CMDDIR\CONFIG.SYS
COPY Z:\HOSTDATA.BIN C:\HOSTDATA.BIN
COPY C:\HOSTDATA.BIN Z:\CMDDIR\BACK.BIN
ECHO N| COMP Z:\HOSTDATA.BIN C:\HOSTDATA.BIN
DEL C:\HOSTDATA.BIN
MD C:\XC
XCOPY Z:\CMDDIR\*.* C:\XC\ /S
XCOPY C:\XC\*.* Z:\XCBACK\ /S
REN Z:\CMDDIR\CONFIG.SYS CONFIG.TXT
ATTRIB +R Z:\CMDDIR\CONFIG.TXT
ATTRIB Z:\CMDDIR\*.*
DEL Z:\CMDDIR\CONFIG.TXT
ATTRIB -R Z:\CMDDIR\CONFIG.TXT
DIR Z:\CMDDIR\*.TXT
DEL Z:\CMDDIR\CONFIG.TXT
DIR \\SMBHOST\DATA\CMDDIR
MD Z:\EMPTY
RD Z:\EMPTY
COPY C:\CONFIG.SYS LPT3
NET USE LPT3 /D
NET USE Z: /D
NET USE
NET CONFIG REQUESTER
NET LOGOFF
ECHO === LANTEST.CMD done

/* W16TEST's resources: strings, a menu, accelerators and a dialog. */
#include <windows.h>
#include "w16test.h"

STRINGTABLE
BEGIN
    IDS_HELLO, "Hello strings"
    IDS_SEVENTEEN, "seventeen"
END

TestMenu MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open", IDM_OPEN
        MENUITEM "&Save", IDM_SAVE
        MENUITEM "&Quit", IDM_QUIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", IDM_ABOUT
    END
END

TestAcc ACCELERATORS
BEGIN
    VK_F5, IDA_F5, VIRTKEY
    "^Q", IDA_CTRLQ
END

TestDlg DIALOG 10, 10, 220, 150
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "W16TEST dialog"
BEGIN
    LTEXT           "&Label:", IDC_LABEL, 6, 8, 40, 9
    EDITTEXT        IDC_EDIT, 50, 6, 100, 12, ES_AUTOHSCROLL
    EDITTEXT        IDC_MULTI, 50, 22, 100, 30, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    CONTROL         "&Keep", IDC_KEEP, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 6, 58, 50, 10
    CONTROL         "One", IDC_R1, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 6, 72, 50, 10
    CONTROL         "Two", IDC_R2, "BUTTON", BS_AUTORADIOBUTTON, 6, 84, 50, 10
    CONTROL         "Three", IDC_R3, "BUTTON", BS_AUTORADIOBUTTON, 6, 96, 50, 10
    LISTBOX         IDC_LIST, 156, 6, 60, 40, LBS_NOTIFY | LBS_SORT | WS_VSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    COMBOBOX        IDC_COMBO, 156, 50, 60, 50, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_DROP, 156, 68, 60, 50, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    SCROLLBAR       IDC_SCROLL, 60, 110, 100, 10, SBS_HORZ | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 120, 128, 44, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 128, 44, 14
END

1 VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "rs2"
            VALUE "FileDescription", "rs2 native Win16 checks"
            VALUE "FileVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

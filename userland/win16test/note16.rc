/* NOTE16's menu and accelerators. */
#include <windows.h>
#include "note16.h"

Note16 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New", IDM_NEW
        MENUITEM "&Open...\tCtrl+O", IDM_OPEN
        MENUITEM "&Save\tCtrl+S", IDM_SAVE
        MENUITEM "Save &As...", IDM_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "&Print...", IDM_PRINT
        MENUITEM "P&rint Setup...", IDM_PRINTSETUP
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", IDM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X", IDM_CUT
        MENUITEM "&Copy\tCtrl+C", IDM_COPY
        MENUITEM "&Paste\tCtrl+V", IDM_PASTE
        MENUITEM "De&lete\tDel", IDM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Select &All", IDM_SELALL
        MENUITEM "Time/&Date\tF5", IDM_TIME
    END
    POPUP "&Search"
    BEGIN
        MENUITEM "&Find...", IDM_FIND
        MENUITEM "Find &Next\tF3", IDM_FINDNEXT
        MENUITEM "&Replace...", IDM_REPLACE
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Word Wrap", IDM_WRAP
        MENUITEM "&Font...", IDM_FONT
        MENUITEM "&Background Color...", IDM_COLOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Note16...", IDM_ABOUT
    END
END

Note16 ACCELERATORS
BEGIN
    "^O", IDM_OPEN
    "^S", IDM_SAVE
    VK_F5, IDM_TIME, VIRTKEY
    VK_F3, IDM_FINDNEXT, VIRTKEY
END

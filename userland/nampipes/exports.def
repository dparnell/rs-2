; NAMPIPES.DLL: OS/2 1.x's named pipe module. As Warp's, it only forwards
; its entries (IBM's ordinals and names) to the kernel's 16-bit DOSCALLS
; named pipe calls 399-412.
DOSMAKENMPIPE=DOSCALLS.399 @1
DOSQNMPIPEINFO=DOSCALLS.400 @2
DOSCONNECTNMPIPE=DOSCALLS.401 @3
DOSDISCONNECTNMPIPE=DOSCALLS.402 @4
DOSQNMPHANDSTATE=DOSCALLS.403 @5
DOSSETNMPHANDSTATE=DOSCALLS.404 @6
DOSPEEKNMPIPE=DOSCALLS.405 @7
DOSWAITNMPIPE=DOSCALLS.406 @8
DOSTRANSACTNMPIPE=DOSCALLS.407 @9
DOSCALLNMPIPE=DOSCALLS.408 @10
DOSRAWREADNMPIPE=DOSCALLS.409 @11
DOSRAWWRITENMPIPE=DOSCALLS.410 @12
DOSSETNMPIPESEM=DOSCALLS.411 @13
DOSQNMPIPESEMSTATE=DOSCALLS.412 @14

; Open32's registry calls: forwarders to REGISTRY.DLL, as in IBM's PMWINX
REGCLOSEKEY=REGISTRY.1 @541
REGCREATEKEY=REGISTRY.3 @542
REGCREATEKEYEX=REGISTRY.4 @543
REGDELETEKEY=REGISTRY.7 @544
REGDELETEVALUE=REGISTRY.9 @545
REGENUMKEY=REGISTRY.11 @546
REGENUMKEYEX=REGISTRY.12 @547
REGENUMVALUE=REGISTRY.15 @548
REGOPENKEY=REGISTRY.22 @549
REGOPENKEYEX=REGISTRY.23 @550
REGQUERYINFOKEY=REGISTRY.26 @551
REGQUERYVALUE=REGISTRY.30 @552
REGQUERYVALUEEX=REGISTRY.31 @553
REGSETVALUE=REGISTRY.42 @554
REGSETVALUEEX=REGISTRY.43 @555

#include <windows.h>
#include "gui32.h"

IDI_MAIN ICON "gui32.ico"

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Hello", IDM_HELLO
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", IDM_ABOUT
    END
END

IDA_MAIN ACCELERATORS
BEGIN
    "H", IDM_HELLO, VIRTKEY, CONTROL
    VK_F1, IDM_ABOUT, VIRTKEY
END

STRINGTABLE
BEGIN
    IDS_HELLO "Hello, resources"
END

IDD_TEST DIALOGEX 0, 0, 200, 122
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GUI32 dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Name:", IDC_LABEL, 7, 8, 40, 8
    EDITTEXT IDC_EDIT, 50, 6, 100, 14, ES_AUTOHSCROLL
    LISTBOX IDC_LIST, 7, 26, 80, 54, LBS_SORT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_COMBO, 95, 26, 90, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX "&Check", IDC_CHECK, 95, 46, 60, 10
    AUTORADIOBUTTON "Radio &1", IDC_R1, 95, 60, 50, 10, WS_GROUP
    AUTORADIOBUTTON "Radio &2", IDC_R2, 95, 72, 50, 10
    ICON IDI_MAIN, IDC_PIC, 160, 50, 20, 20
    DEFPUSHBUTTON "OK", IDOK, 40, 100, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 110, 100, 50, 14
END
